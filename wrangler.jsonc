{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerasos-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the "name" of this worker (the Pages project name),
      // NOT the package.json name ("cerasos-web").
      "service": "cerasos-frontend"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
